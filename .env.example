# ==========================================================================
# NeuroLab Enterprise — variables de entorno
# Copia este archivo a .env (nunca lo confirmes al repositorio).
# ==========================================================================

# --- Backend --------------------------------------------------------------
NEUROLAB_ENV=development
# Obligatorio en producción: usa una cadena larga y aleatoria.
NEUROLAB_SECRET=replace-with-a-long-random-secret
# Horas de validez del token HMAC.
NEUROLAB_TOKEN_HOURS=8

# SQLite (desarrollo/pruebas):
# NEUROLAB_DATABASE_URL=sqlite:///./neurolab.db
# PostgreSQL (producción / docker compose):
# NEUROLAB_DATABASE_URL=postgresql+psycopg://neurolab:password@localhost:5432/neurolab
NEUROLAB_DATABASE_URL=sqlite:///./neurolab.db

# Directorio de artefactos (CSV y modelos .npz).
NEUROLAB_STORAGE_DIR=./storage
# Límite de subida CSV en bytes (5 MB por defecto).
NEUROLAB_MAX_UPLOAD_BYTES=5000000
# Hilos del worker de entrenamiento.
NEUROLAB_WORKERS=2
# Pausa didáctica entre épocas (ms). No altera las métricas reales.
NEUROLAB_EPOCH_DELAY_MS=120
# Crear usuarios/proyecto/dataset de demostración al primer arranque.
NEUROLAB_SEED_DEMO=true
# Límites de peticiones por minuto.
NEUROLAB_LOGIN_RATE_LIMIT=10
NEUROLAB_WRITE_RATE_LIMIT=120
# Orígenes permitidos por CORS (separados por coma).
NEUROLAB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# --- Frontend -------------------------------------------------------------
# URL de la API. Vacío = mismo origen (útil detrás de nginx).
VITE_API_URL=http://127.0.0.1:8000

# --- Docker Compose -------------------------------------------------------
POSTGRES_PASSWORD=neurolab_dev_password
WEB_PORT=8080
